// PRS-from-BAM pipeline configuration

manifest {
    name            = 'prs-from-bam'
    description     = 'Breast cancer PRS (BCAC 313 / BRIDGES 306) from germline WGS BAM/CRAM'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    // Required
    input          = null      // BAM/CRAM glob ('bams/*.bam') or samplesheet .csv/.tsv (columns: sample, bam[, index])
    fasta          = null      // reference FASTA used for alignment (with .fai)

    // Output
    outdir         = 'results'
    batch          = 'cohort'  // label used in output file names
    publish_mode   = 'copy'

    // Panels: comma-separated names under panel_dir; first = primary, second = secondary
    panels         = 'BCAC_313,BRIDGES_306'
    panel_dir      = "${projectDir}/panels"

    // Sample names from file names (glob input only): strip these, else strip .bam/.cram
    strip_prefix   = ''
    strip_suffix   = ''

    // Genotyping
    min_mapq       = 20
    min_baseq      = 20
    force_expected = null      // optional TSV (column 'site' CHROM:POS or 'ID'): sites scored at 2 x EAF

    // Container image for -profile docker / singularity (built by .github/workflows/container.yml)
    container      = 'ghcr.io/qihong0925/prs-from-bam:latest'

    // Tiered/archived storage: limit concurrent genotyping jobs (0 = no limit) and retry with a wait
    genotype_max_forks = 0
    genotype_retries   = 2
    retry_wait_sec     = 0
}

process {
    shell  = ['/bin/bash', '-euo', 'pipefail']
    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withName: 'GENOTYPE' {
        maxForks      = params.genotype_max_forks ?: null
        maxRetries    = params.genotype_retries
        errorStrategy = {
            if (task.attempt <= params.genotype_retries) {
                sleep(params.retry_wait_sec * 1000L)
                return 'retry'
            }
            return 'finish'
        }
    }
    withName: 'MERGE_SCORE' {
        memory = '8 GB'
        time   = '4h'
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor   = 'slurm'
        executor.queueSize = 50
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/env/nextflow_env.yml"
    }
    // Container profiles: the pipeline directory is mounted so bin/, py/, panels/ and resources/ are visible
    docker {
        docker.enabled     = true
        docker.runOptions  = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}"
        process.container  = params.container
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "-B ${projectDir}"
        process.container      = "docker://${params.container}"
    }
    // Use the existing environment script (modules + conda env; settings in config/local.sh)
    env_prs {
        process.beforeScript = "set +eu; source ${projectDir}/env/env_prs.sh; set -eu"
    }
    // Tiny synthetic data set (tests/make_test_data.py); needs bcftools/samtools/python on PATH or -profile conda
    test {
        params.input     = "${projectDir}/tests/data/bams/*.{bam,cram}"
        params.fasta     = "${projectDir}/tests/data/ref.fa"
        params.panel_dir = "${projectDir}/tests/data/panels"
        params.batch     = 'test'
        params.outdir    = 'results_test'
        process.resourceLimits = [cpus: 1, memory: 2.GB, time: 1.h]
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
